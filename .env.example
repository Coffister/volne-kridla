# Copy to .env.local for local dev, and set the same values in the Vercel
# project settings. .env* is gitignored — never commit real keys.

# --- Public (safe to expose in the browser bundle) ---------------------------
# Supabase → Settings → API
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# --- Server only (build step + Vercel; NEVER prefixed with VITE_) ------------
# Used by scripts/fetch-content.mjs to read content at build time.
# Supabase → Settings → API → service_role secret
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret

# Vercel Deploy Hook URL — the admin "Publish" action pings this to rebuild
# the public site. Create it in Vercel → Settings → Git → Deploy Hooks.
# Stored as a Supabase secret / Edge Function env, not needed by the frontend.
# VERCEL_DEPLOY_HOOK_URL=https://api.vercel.com/v1/integrations/deploy/...
